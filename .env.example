# HTTP port the MCP server listens on
PORT=8080

# Auth for the MCP endpoint itself (strongly recommended for any deployed instance).
# Clients authenticate with "Authorization: Bearer <token>" OR by using the URL path /mcp/<token>
# (the path form is for clients that cannot send custom headers, e.g. claude.ai custom connectors).
# Generate one: openssl rand -hex 32
MCP_AUTH_TOKEN=

# --- Per-user auth via Microsoft Entra ID (optional; see docs/ENTRA_SETUP.md) ---
# When both are set, the server also accepts Entra-issued bearer JWTs and
# advertises OAuth discovery metadata. Works alongside MCP_AUTH_TOKEN.
AZURE_TENANT_ID=
AZURE_CLIENT_ID=

# --- ConnectWise PSA (Manage) ---
# Cloud sites must use the api- prefix (api-na / api-eu / api-au / api-aus / api-za).
# The server auto-corrects e.g. "na.myconnectwise.net" -> "api-na.myconnectwise.net".
# On-premise: use your own hostname.
CW_PSA_SITE=api-na.myconnectwise.net
CW_PSA_COMPANY_ID=
CW_PSA_PUBLIC_KEY=
CW_PSA_PRIVATE_KEY=
# Developer clientId GUID from https://developer.connectwise.com/ClientID
CW_PSA_CLIENT_ID=
# Optional: pin the API model version (Accept: application/vnd.connectwise.com+json; version=X), e.g. 2026.4
CW_PSA_VERSION=

# --- ConnectWise Automate (optional module; tools register only when all four are set) ---
# e.g. https://automate.example.com
CW_AUTOMATE_URL=
CW_AUTOMATE_USERNAME=
CW_AUTOMATE_PASSWORD=
CW_AUTOMATE_CLIENT_ID=

# --- Write gate (per product; default read-only) ---
# Write tools stay listed but refuse until their product's MODE is "write" (or "true").
# The disruptive tier (reboots, disruptive agent commands, deletes, uninstalls and the
# raw *_api_write passthroughs) additionally needs ALLOW_DESTRUCTIVE=true. Every write
# call also needs confirm: true. cw_status_gate reports the state.
CW_PSA_MODE=
CW_PSA_ALLOW_DESTRUCTIVE=
CW_AUTOMATE_MODE=
CW_AUTOMATE_ALLOW_DESTRUCTIVE=

# The remote entry REFUSES TO START unless MCP_AUTH_TOKEN or the Entra pair above
# is set. This connector can create and update tickets, add notes, and create time
# and expense entries, so an unauthenticated endpoint is not a degraded deployment
# of it. Set this to true only for a local, non-routable test run — it announces
# itself loudly on every start.
MCP_ALLOW_ANONYMOUS=
